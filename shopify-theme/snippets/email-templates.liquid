{% capture welcome_email_html %}
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Bienvenue dans la Storm — TORNADO</title>
</head>
<body style="margin: 0; padding: 0; background-color: #0A0A0A; color: #FFFFFF; font-family: 'Helvetica Neue', Arial, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto; background-color: #141414; border: 1px solid #262626;">
    <tr>
      <td style="padding: 40px 20px; text-align: center; border-bottom: 1px solid #262626;">
        <h1 style="font-family: 'Syne', Arial, sans-serif; font-size: 28px; font-weight: 900; letter-spacing: 0.2em; color: #D4AF37; margin: 0;">TORNADO</h1>
        <p style="font-size: 11px; letter-spacing: 0.15em; color: #A0A0A0; text-transform: uppercase; margin-top: 5px;">LUXURY STREETWEAR</p>
      </td>
    </tr>
    <tr>
      <td style="padding: 40px 30px; text-align: center;">
        <h2 style="font-size: 22px; font-weight: 800; letter-spacing: 0.1em; color: #FFFFFF; margin-bottom: 15px;">BIENVENUE DANS LA STORM</h2>
        <p style="font-size: 14px; color: #A0A0A0; line-height: 1.6; margin-bottom: 25px;">
          Vous faites désormais partie du cercle VIP TORNADO. Comme promis, voici votre code privilège de 10% valable sur votre première commande :
        </p>
        <div style="display: inline-block; background: #0A0A0A; border: 2px dashed #D4AF37; padding: 15px 30px; font-family: monospace; font-size: 20px; font-weight: bold; color: #D4AF37; letter-spacing: 0.15em; margin-bottom: 30px;">
          STORM10
        </div>
        <br>
        <a href="{{ shop.url }}" style="display: inline-block; background: linear-gradient(135deg, #FFF0B3 0%, #D4AF37 50%, #997A15 100%); color: #0A0A0A; text-decoration: none; font-weight: 800; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; padding: 16px 36px; border-radius: 4px;">
          PROFITER DE MES -10% &rarr;
        </a>
      </td>
    </tr>
    <tr>
      <td style="padding: 25px; text-align: center; background-color: #0A0A0A; border-top: 1px solid #262626; font-size: 11px; color: #666666;">
        TORNADO PARIS &bull; Tous droits réservés.<br>
        <a href="{{ unsubscribe_url }}" style="color: #A0A0A0; text-decoration: underline;">Se désinscrire</a>
      </td>
    </tr>
  </table>
</body>
</html>
